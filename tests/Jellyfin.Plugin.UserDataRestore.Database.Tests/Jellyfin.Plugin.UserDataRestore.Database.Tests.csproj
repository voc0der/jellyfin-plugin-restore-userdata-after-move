<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- These tests exist to catch the server's provider failing to translate
         a query, which is a runtime failure nothing the compiler or a core test
         can see.

         Separate from the adapter tests because those construct Jellyfin
         entities and so pull in Jellyfin.Controller, which carries a framework
         reference to ASP.NET Core. Nothing here needs an entity — the reader
         talks to a database — so nothing here needs that runtime, and this suite
         stays runnable on a machine that has the .NET 10 runtime without the
         ASP.NET Core 10 one. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- Pinned to what the server actually ships, taken from the host package's
       own dependency. A test that verified translation against some other
       version of the provider would be verifying the wrong thing. -->
  <PropertyGroup>
    <JellyfinPackageVersion>12.0.0</JellyfinPackageVersion>
    <EntityFrameworkVersion>10.0.10</EntityFrameworkVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <!-- Kept in step with the adapter project on purpose: tests/Fixtures is
         compiled into both, so a version here that differs from the one there
         means the same source is built against two NSubstitute versions. -->
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Database.Implementations" Version="$(JellyfinPackageVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="$(EntityFrameworkVersion)" />

    <!-- Pinned past the native SQLite build EF's own dependency drags in, which
         carries a high-severity advisory. It never reaches an archive — build.sh
         refuses to package anything but this plugin's two assemblies — but a
         known-vulnerable transitive dependency sitting in the build output is
         not something to leave for a scanner to find later. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!-- The database layer compiled straight in, rather than referenced through
       the plugin project. Referencing the plugin drags in Jellyfin.Controller
       and with it the ASP.NET Core framework reference, which is what confines a
       test run to whichever machines have that exact runtime — the constraint
       that kept the 12.0 provider untested in the first place.

       It is a narrower claim than "the shipped assembly was tested", and worth
       being plain about: what these exercise is the same source, the same
       expression trees, and the same provider, which is all that query
       translation depends on. It also asserts something on its own. These two
       files have no business knowing about Jellyfin.Controller, and the day one
       of them acquires a reference to it, this project stops compiling. -->
  <ItemGroup>
    <ProjectReference Include="../../src/Jellyfin.Plugin.UserDataRestore.Core/Jellyfin.Plugin.UserDataRestore.Core.csproj" />
    <Compile Include="../Fixtures/UserDataDatabase.cs" Link="UserDataDatabase.cs" />
    <Compile Include="../../src/Jellyfin.Plugin.UserDataRestore/Jellyfin/UserDataReader.cs" Link="UserDataReader.cs" />
    <Compile Include="../../src/Jellyfin.Plugin.UserDataRestore/Jellyfin/DatabaseModelGate.cs" Link="DatabaseModelGate.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
