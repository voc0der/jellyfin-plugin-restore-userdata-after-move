<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- These tests are about this plugin's own adapter code against real
         Jellyfin entity types. A Jellyfin reference drags in the ASP.NET Core
         shared runtime, so running them needs the ASP.NET Core 10 runtime
         installed, not just the .NET 10 one. -->
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="10.0.1" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="NSubstitute" Version="6.2.0" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0" />
  </ItemGroup>

  <!-- The plugin excludes the host assemblies at runtime, because the running
       server supplies them and a second copy inside the archive breaks type
       identity. A test host is not a server, so here they are referenced
       normally: without the runtime assets there is no BaseItem to construct
       and nothing to test against. -->
  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="12.0.0" />
    <PackageReference Include="Jellyfin.Database.Implementations" Version="12.0.0" />

    <!-- The write path talks to the database as well as to the managers, so the
         faults worth injecting into it are database faults. Kept in step with the
         database project's provider pin. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />

    <!-- Pinned past the native SQLite build EF's own dependency drags in, which
         carries a high-severity advisory. The sibling database project has
         carried this pin since it was created; this one was left without it and
         raised the advisory on its own. It never reaches an archive — build.sh
         refuses to package anything but this plugin's two assemblies — but a
         known-vulnerable transitive dependency in the build output is not
         something to leave for a scanner to find later. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Jellyfin.Plugin.UserDataRestore/Jellyfin.Plugin.UserDataRestore.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../Fixtures/UserDataDatabase.cs" Link="UserDataDatabase.cs" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

</Project>
